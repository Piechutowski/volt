func (c DigestChangeset) RtSet(v []byte) DigestChangeset {
	return DigestChangeset{rt.Set(c.Changeset, 0, func(voltR *Digest) { voltR.Rt = v })}
}

func (c DigestChangeset) SizeSet(v int64) DigestChangeset {
	return DigestChangeset{rt.Set(c.Changeset, 1, func(voltR *Digest) { voltR.Size = v })}
}

func (c DigestChangeset) Cast(p DigestParams, allow ...DigestColumn) DigestChangeset {
	return DigestChangeset{c.Changeset.Cast(p, allow...)}
}

func (c DigestChangeset) ErrorAdd(col DigestColumn, msg string) DigestChangeset {
	return DigestChangeset{c.Changeset.ErrorAdd(col, msg)}
}

func voltDigestScan(r rt.Row) (Digest, error) {
	var voltV Digest
	voltErr := r.Scan((*rt.Bytes)(&voltV.Rt), &voltV.Size)
	return voltV, rt.Refused("Digest", voltErr)
}

func voltDigestValues(voltR Digest) []any { return []any{rt.Bytes(voltR.Rt), voltR.Size} }

func voltDigestApply(voltData, voltVals Digest, voltSet []bool) Digest {
	voltR := voltData
	if voltSet[0] {
		voltR.Rt = voltVals.Rt
	}
	if voltSet[1] {
		voltR.Size = voltVals.Size
	}
	return voltR
}

func voltDigestCast(
	c rt.Changeset[Digest],
	p rt.Params[Digest],
	i int,
) (rt.Changeset[Digest], error) {
	switch i {
	case 0:
		return DigestChangeset{c}.voltRtCast(p)
	case 1:
		return DigestChangeset{c}.voltSizeCast(p)
	}
	return c, nil
}

func (c DigestChangeset) voltRtCast(p DigestParams) (rt.Changeset[Digest], error) {
	voltV, voltOK, voltErr := rt.Field(p, "rt", "[]byte", rt.NotNull, func(voltR *Digest) []byte {
		return voltR.Rt
	})
	if voltErr != nil || !voltOK {
		return c.Changeset, voltErr
	}
	return c.RtSet(voltV).Changeset, nil
}

func (c DigestChangeset) voltSizeCast(p DigestParams) (rt.Changeset[Digest], error) {
	voltV, voltOK, voltErr := rt.Field(p, "size", "int", rt.NotNull, func(voltR *Digest) int64 {
		return voltR.Size
	})
	if voltErr != nil || !voltOK {
		return c.Changeset, voltErr
	}
	return c.SizeSet(voltV).Changeset, nil
}
