// Digest is a row of the digests table.
type Digest struct {
	// Named like the runtime package Get and Delete bind through
	Rt   []byte `db:"rt" json:"rt"`
	Size int    `db:"size" json:"size"`
}

// DigestColumn is a column handle of Digest, the element of a Cast allow list
// (spec §changesets).
type DigestColumn = rt.ColumnOf[Digest]

// DigestParams is a digests write body as the wire carries it (spec §changesets).
type DigestParams = rt.Params[Digest]

// Typed column handles of Digest (spec §changesets): the Cast allow list of
// a changeset, and the inert predicate, order and assignment builders
// of the dynamic query layer. A predicate built here can only enter Digest
// queries; mixing models is a compile error.
var (
	DigestRt   = rt.Column[Digest, []byte]{Name: "rt"}
	DigestSize = rt.Column[Digest, int]{Name: "size"}
)

// DigestChangeset carries a digests row, the changes proposed to it and the
// errors found so far (spec §changesets). It is a value: every method
// returns a new changeset and leaves its receiver as it was.
type DigestChangeset struct {
	data  Digest
	vals  Digest
	row   bool
	set   [2]bool
	errs  []rt.FieldError
	valid []rt.FieldError
}

// DigestNew starts a changeset for a digests row to create, the schema's literal
// defaults in place (spec §changesets).
func DigestNew() DigestChangeset { return DigestChangeset{} }

// Changeset starts a changeset for an update of r, nothing set (spec
// §changesets).
func (r Digest) Changeset() DigestChangeset { return DigestChangeset{data: r, row: true} }

// From marks every data column of r but the auto-increment key (spec
// §changesets).
func (c DigestChangeset) From(r Digest) DigestChangeset {
	c = c.RtSet(r.Rt)
	c = c.SizeSet(r.Size)
	return c
}

// RtSet sets rt and marks it; nil is empty bytes (spec §columns).
func (c DigestChangeset) RtSet(v []byte) DigestChangeset {
	c.vals.Rt, c.set[0] = v, true
	return c
}

// SizeSet sets size and marks it (spec §changesets).
func (c DigestChangeset) SizeSet(v int) DigestChangeset {
	c.vals.Size, c.set[1] = v, true
	return c
}

// Cast sets every column of allow that p carries, recording a cast
// error for a value that does not convert and an unknown_field error
// for a key that names no column (spec §changesets).
func (c DigestChangeset) Cast(p DigestParams, allow ...DigestColumn) DigestChangeset {
	c.errs = rt.FieldErrorsAppend(c.errs, rt.UnknownFields(p, "rt", "size")...)
	for _, col := range allow {
		switch col.ColumnName() {
		case "rt":
			if v, ok, err := rt.Field(p, "rt", "[]byte", false, func(r *Digest) []byte { return r.Rt }); err != nil {
				c = c.errorAdd("cast", err.Error(), "rt")
			} else if ok {
				c = c.RtSet(v)
			}
		case "size":
			if v, ok, err := rt.Field(p, "size", "int", false, func(r *Digest) int { return r.Size }); err != nil {
				c = c.errorAdd("cast", err.Error(), "size")
			} else if ok {
				c = c.SizeSet(v)
			}
		}
	}
	return c
}

// Changed reports whether col is marked (spec §changesets).
func (c DigestChangeset) Changed(col DigestColumn) bool {
	switch col.ColumnName() {
	case "rt":
		return c.set[0]
	case "size":
		return c.set[1]
	}
	return false
}

// Row is the data with the marked values applied (spec §changesets).
func (c DigestChangeset) Row() Digest {
	r := c.data
	if c.set[0] {
		r.Rt = c.vals.Rt
	}
	if c.set[1] {
		r.Size = c.vals.Size
	}
	return r
}

// Params is the marked columns of c as a write body, each under its
// wire name (spec §changesets).
func (c DigestChangeset) Params() DigestParams {
	var marks []rt.Mark
	if c.set[0] {
		marks = append(marks, rt.Mark{Wire: "rt", Value: c.vals.Rt})
	}
	if c.set[1] {
		marks = append(marks, rt.Mark{Wire: "size", Value: c.vals.Size})
	}
	return rt.ParamsOf(c.Row(), marks...)
}

