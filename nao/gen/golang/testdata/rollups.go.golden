		voltV, voltOK, voltErr := rt.Field(p, "merchant_id", "int", false, func(voltR *MerchantPeriod) int { return voltR.MerchantID })
		if voltErr != nil || !voltOK {
			return c, voltErr
		}
		return MerchantPeriodChangeset{c}.MerchantIDSet(voltV).Changeset, nil
	case 2:
		voltV, voltOK, voltErr := rt.Field(p, "country_code", "string", false, func(voltR *MerchantPeriod) string { return voltR.CountryCode })
		if voltErr != nil || !voltOK {
			return c, voltErr
		}
		return MerchantPeriodChangeset{c}.CountryCodeSet(voltV).Changeset, nil
	}
	return c, nil
}
