func (r Ping) Changeset() PingChangeset { return PingChangeset{rt.ChangesetOf(voltPingDesc, r)} }

func (c PingChangeset) From(r Ping) PingChangeset { return PingChangeset{c.Changeset.From(r)} }

func (c PingChangeset) Cast(p PingParams, allow ...PingColumn) PingChangeset {
	return PingChangeset{c.Changeset.Cast(p, allow...)}
}

func (c PingChangeset) ErrorAdd(col PingColumn, msg string) PingChangeset {
	return PingChangeset{c.Changeset.ErrorAdd(col, msg)}
}

func voltPingScan(r rt.Row) (Ping, error) {
	var voltV Ping
	voltErr := r.Scan(&voltV.ID)
	return voltV, rt.Refused("Ping", voltErr)
}

func voltPingValues(voltR Ping) []any { return []any{voltR.ID} }

func voltPingApply(voltData, voltVals Ping, voltSet []bool) Ping {
	return voltData
}

func voltPingCast(c rt.Changeset[Ping], p rt.Params[Ping], i int) (rt.Changeset[Ping], error) {
	return c, nil
}
