-- Code generated by volt gen from docs.volt. DO NOT EDIT.

PRAGMA foreign_keys = ON;

-- A blog post.
--
-- Multi-line doc comments keep their blank lines and become
-- paragraph breaks in godoc.
CREATE TABLE posts (
  id INTEGER PRIMARY KEY,
  -- Shown in lists and in the HTML title tag
  title TEXT NOT NULL,
  status TEXT NOT NULL,
  -- Raw markdown source.
  -- Rendered to HTML at publish time.
  body TEXT,
  published_at TIMESTAMP,
  author_id INTEGER NOT NULL,
  -- The writer of a post.
  FOREIGN KEY (author_id) REFERENCES users (id)
);
-- Lists a writer's posts.
CREATE INDEX idx_posts_author_id_id ON posts (author_id, id);
CREATE INDEX idx_posts_published_at_id ON posts (published_at, id);

CREATE TABLE tags (
  id INTEGER PRIMARY KEY,
  name TEXT NOT NULL
);
CREATE UNIQUE INDEX idx_tags_name ON tags (name);

-- A person who writes posts.
CREATE TABLE users (
  id INTEGER PRIMARY KEY
);

-- The tags every blog starts with.
INSERT INTO tags (id, name) VALUES
  (1, 'news');
