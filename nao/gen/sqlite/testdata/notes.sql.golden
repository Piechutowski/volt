-- Code generated by volt gen from notes.volt. DO NOT EDIT.

PRAGMA foreign_keys = ON;

-- A blog post.
--
-- Multi-line notes keep their blank lines and become
-- paragraph breaks in godoc.
CREATE TABLE posts (
  id INTEGER PRIMARY KEY,
  -- Shown in lists and in the HTML title tag
  title TEXT NOT NULL,
  status TEXT NOT NULL,
  -- Raw markdown source.
  -- Rendered to HTML at publish time.
  body TEXT,
  published_at TIMESTAMP
);

CREATE TABLE tags (
  id INTEGER PRIMARY KEY,
  name TEXT NOT NULL
);
CREATE UNIQUE INDEX idx_tags_name ON tags (name);
