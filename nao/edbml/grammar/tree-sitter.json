{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "edbml",
      "camelcase": "Edbml",
      "title": "EDBML",
      "scope": "source.edbml",
      "path": ".",
      "file-types": ["volt", "edbml", "dbml"],
      "injection-regex": "^(e?dbml|volt)$"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "Apache-2.0",
    "description": "EDBML/Volt grammar for tree-sitter: DBML, its EDBML extensions, and the Volt routing layer (.volt files)",
    "authors": [
      {
        "name": "Szymon Piechutowski"
      }
    ],
    "links": {
      "repository": "https://github.com/Piechutowski/volt"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
